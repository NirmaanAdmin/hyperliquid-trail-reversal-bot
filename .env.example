# ─── Hyperliquid auth (LIVE mode only — leave unset for paper) ───
# Authorize an API wallet at https://app.hyperliquid.xyz/API
HL_SECRET_KEY=            # API/agent wallet PRIVATE key (0x...). NEVER commit.
HL_ACCOUNT_ADDRESS=       # your MAIN wallet PUBLIC address (0x...)
HL_NETWORK=mainnet        # mainnet | testnet
HL_CROSS_MARGIN=true      # true=cross, false=isolated
HL_SLIPPAGE=0.01          # max market-order slippage (1%)

# ─── Mode ───
PAPER_MODE=true           # true = simulate (no orders sent, no key needed)
PAPER_START_USDT=1000     # starting paper wallet for P&L/target/baseline

# ─── Webhook / sizing ───
WEBHOOK_SECRET=changeme
DEFAULT_LEVERAGE=5
FIXED_MARGIN_USDT=20      # USDC margin deployed per trade
WALLET_USAGE_PCT=100
MIN_NOTIONAL_USDT=10      # Hyperliquid minimum order value
SYMBOL_OVERRIDES={}       # e.g. {"1000PEPEUSDT":"kPEPE"}

# ─── Risk subsystems (same knobs as before) ───
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_PCT=13.0
PROFIT_LOCK_POLL_SEC=10
PROFIT_LOCK_COOLDOWN_SEC=300

DAILY_CAP_ENABLED=true
DAILY_CAP_PCT=26.0

SL_LOCKOUT_ENABLED=true
SL_LOCKOUT_SEC=600

TARGET_ENABLED=true
TARGET_CURRENT_VALUE=0     # 0 = disabled; set in USDC
TARGET_POLL_SEC=5

BASELINE_ENABLED=false
BASELINE_TRIGGER_PCT=6.0
BASELINE_ROLLOVER_PCT=5.0
BASELINE_COOLDOWN_SEC=60

NATIVE_SL_ENABLED=false    # true = place real reduce-only stop orders on HL

# ─── State files (mount a Railway volume at /app/data for persistence) ───
ACTIVE_TRADES_FILE=/app/data/active_trades.json
TARGET_FILE=/app/data/target_state.json
BASELINE_FILE=/app/data/baseline_state.json
